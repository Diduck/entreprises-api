# Copier ce fichier en .env :  cp .env.example .env

# Base MariaDB du docker-compose.yml (lancer `docker compose up -d` avant l'API).
DATABASE_URL=mysql://entreprises:entreprises-demo@127.0.0.1:3308/entreprises

# Base utilisée par `make test` : `#[sqlx::test]` y note les bases jetables qu'il crée (une par test).
TEST_DATABASE_URL=mysql://entreprises:entreprises-demo@127.0.0.1:3308/entreprises_tests

# Adresse d'écoute du serveur.
BIND_ADDR=127.0.0.1:3000

# Clé de signature des JWT (HS256), 32 caractères au moins. Quiconque la connaît peut fabriquer un token admin :
# la garder secrète, hors du code. En générer une nouvelle :  openssl rand -hex 32
# Changer la clé invalide immédiatement tous les tokens déjà émis.
JWT_SECRET=demo-uniquement-3f9c1e7a5b2d8f4a6c0e9b1d7a3f5c8e

# Durée de validité d'un token, en minutes (1 à 1440). Après, se reconnecter via POST /api/v1/tokens.
JWT_DUREE_MINUTES=15

# Niveau de logs (méthode, chemin, statut, durée).
RUST_LOG=entreprises_api=info,tower_http=info
