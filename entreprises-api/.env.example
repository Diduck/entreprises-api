# Copier ce fichier en .env :  cp .env.example .env

# Base MariaDB du compose.yml (lancer `docker compose up -d` avant l'API).
DATABASE_URL=mysql://entreprises:entreprises-demo@127.0.0.1:3308/entreprises

# Base utilisée par `make test` : `#[sqlx::test]` y note les bases jetables qu'il crée (une par test).
TEST_DATABASE_URL=mysql://entreprises:entreprises-demo@127.0.0.1:3308/entreprises_tests

# Adresse d'écoute du serveur.
BIND_ADDR=127.0.0.1:3000

# Connexion : Keycloak (service `keycloak` du compose.yml). Il signe les tokens avec sa clé privée (RS256) ;
# l'API télécharge sa clé publique (JWKS) pour les vérifier. Aucun secret à mettre ici.
OIDC_ISSUER=http://127.0.0.1:8080/realms/entreprises
OIDC_AUDIENCE=entreprises-api
# Facultatif, déduit de OIDC_ISSUER :
# OIDC_JWKS_URL=http://127.0.0.1:8080/realms/entreprises/protocol/openid-connect/certs

# Niveau de logs (méthode, chemin, statut, durée).
RUST_LOG=entreprises_api=info,tower_http=info
